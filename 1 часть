local function getFPSColor(fps)
    if fps < 30 then return Color3.fromRGB(231, 76, 60)
    elseif fps < 55 then return Color3.fromRGB(241, 196, 15)
    else return Color3.fromRGB(46, 204, 113) end
end

local function getPingColor(ping)
    if ping > 150 then return Color3.fromRGB(231, 76, 60)
    elseif ping > 80 then return Color3.fromRGB(241, 196, 15)
    else return Color3.fromRGB(46, 204, 113) end
end

local fpsFrames = 0
local fpsTimer = os.clock()

RunService.RenderStepped:Connect(function()
    fpsFrames = fpsFrames + 1
    local now = os.clock()
    local elapsed = now - fpsTimer

    if elapsed >= 0.5 then
        local currentFPS = math.clamp(math.floor((fpsFrames / elapsed) + 0.5), 1, 1000)
        fpsValueLabel.Text = tostring(currentFPS)
        local fpsColor = getFPSColor(currentFPS)
        fpsValueLabel.TextColor3 = fpsColor
        fpsTextLabel.TextColor3 = fpsColor

        local pingVal = 0
        pcall(function()
            local perfPing = Stats.PerformanceStats.Ping:GetValue()
            if type(perfPing) == "number" and perfPing > 0 then
                pingVal = math.floor(perfPing + 0.5)
            end
        end)

        if pingVal == 0 and player and player.GetNetworkPing then
            pcall(function()
                local netPing = player:GetNetworkPing()
                if type(netPing) == "number" and netPing > 0 then
                    pingVal = math.floor(netPing * 1000 + 0.5)
                end
            end)
        end

        pingValueLabel.Text = tostring(pingVal)
        local pingColor = getPingColor(pingVal)
        pingValueLabel.TextColor3 = pingColor
        pingTextLabel.TextColor3 = pingColor

        fpsFrames = 0
        fpsTimer = now
    end
end)

