local ROLE_COLORS = {
    Murderer = Color3.fromRGB(255, 0, 0),        
    Sheriff  = Color3.fromRGB(0, 120, 255),      
    Hero     = Color3.fromRGB(255, 230, 0),      
    Innocent = Color3.fromRGB(0, 255, 0)          
}

local Highlights = {}
local RoleCache = {}
local RoleCacheTime = 0

local function removeESP(p)
    local highlight = Highlights[p]
    if highlight then
        highlight:Destroy()
        Highlights[p] = nil
    end
end

local function addESP(p, role)
    if p == player or not Toggles.ESPRoles then
        removeESP(p)
        return
    end

    local character = p.Character
    if not character then
        removeESP(p)
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        removeESP(p)
        return
    end

    local color = ROLE_COLORS[role]
    if not color then
        removeESP(p)
        return
    end

    local highlight = Highlights[p]
    if highlight and highlight.Parent ~= character then
        highlight:Destroy()
        highlight = nil
        Highlights[p] = nil
    end

    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "MM2RoleESP"
        highlight.Adornee = character
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 0.45
        highlight.OutlineTransparency = 0
        highlight.Parent = character
        Highlights[p] = highlight
    end

    highlight.FillColor = color
    highlight.OutlineColor = color
end

local function updateESP()
    if not Toggles.ESPRoles then
        for p, _ in pairs(Highlights) do
            removeESP(p)
        end
        return
    end

    local remote = findGetPlayerData()
    if not remote then
        return
    end

    local success, playerData = pcall(function()
        return remote:InvokeServer()
    end)

    if not success or type(playerData) ~= "table" then
        return
    end

    RoleCache = {}
    RoleCacheTime = os.clock()

    for _, p in ipairs(Players:GetPlayers()) do
        if p == player then
            removeESP(p)
            continue
        end

        local data = playerData[p.Name]
        if type(data) ~= "table" then
            removeESP(p)
            continue
        end

        local role = data.Role
        local dead = data.Dead
        RoleCache[p] = {Role = role, Dead = dead}

        if dead == true then
            removeESP(p)
        else
            addESP(p, role)
        end
    end

    for p, highlight in pairs(Highlights) do
        if not p.Parent then
            if highlight then
                highlight:Destroy()
            end
            Highlights[p] = nil
        end
    end
end

Players.PlayerRemoving:Connect(function(p)
    removeESP(p)
