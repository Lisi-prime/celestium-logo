    notifTitle.TextXAlignment = Enum.TextXAlignment.Left
    notifTitle.ZIndex = 101
    notifTitle.Parent = notifFrame

    local notifDesc = Instance.new("TextLabel")
    notifDesc.Size = UDim2.new(1, -60, 0, 14)
    notifDesc.Position = UDim2.new(0, 52, 0, 27)
    notifDesc.BackgroundTransparency = 1
    notifDesc.Text = description
    notifDesc.TextColor3 = Color3.fromRGB(140, 140, 155)
    notifDesc.TextSize = 11
    notifDesc.Font = Enum.Font.Gotham
    notifDesc.TextXAlignment = Enum.TextXAlignment.Left
    notifDesc.ZIndex = 101
    notifDesc.Parent = notifFrame

    local notifData = {Frame = notifFrame}
    table.insert(activeNotifications, notifData)
    updateNotificationPositions()

    task.delay(duration, function()
        for idx, item in ipairs(activeNotifications) do
            if item == notifData then
                table.remove(activeNotifications, idx)
                break
            end
        end
        
        local tween = TweenService:Create(notifFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 20, notifFrame.Position.Y.Scale, notifFrame.Position.Y.Offset)
        })
        tween:Play()
        tween.Completed:Connect(function() 
            notifFrame:Destroy() 
            updateNotificationPositions()
        end)
    end)
end

