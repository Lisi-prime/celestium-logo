    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        barDragging = true
        hasMoved = false
        barDragStart = input.Position
        barStartPos = topToggleBtn.Position
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if barDragging then
            barDragging = false
            if not hasMoved then toggleMenu() end
        end
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if barDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - barDragStart
        if delta.Magnitude > 3 then hasMoved = true end
        topToggleBtn.Position = UDim2.new(barStartPos.X.Scale, barStartPos.X.Offset + delta.X, barStartPos.Y.Scale, barStartPos.Y.Offset + delta.Y)
    end
end)

