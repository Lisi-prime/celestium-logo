local isMenuOpen = true
local isAnimating = false

local function toggleMenu()
    if isAnimating then return end
    isAnimating = true

    if not isMenuOpen then
        mainFrame.Visible = true
        canvasGroup.GroupTransparency = 1
        mainFrame.BackgroundTransparency = 1

        local twInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(mainFrame, twInfo, {BackgroundTransparency = 0.1}):Play()
        local twGroup = TweenService:Create(canvasGroup, twInfo, {GroupTransparency = 0})
        twGroup:Play()
        
        twGroup.Completed:Connect(function() isAnimating = false end)
        isMenuOpen = true
    else
        local twInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        TweenService:Create(mainFrame, twInfo, {BackgroundTransparency = 1}):Play()
        local twGroup = TweenService:Create(canvasGroup, twInfo, {GroupTransparency = 1})
        twGroup:Play()

        twGroup.Completed:Connect(function()
            mainFrame.Visible = false
            isAnimating = false
        end)
        isMenuOpen = false
    end
end

