    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not def or not root then return end

    local ring = Instance.new("Part")
    ring.Name = "AuraCore"
    ring.Size = Vector3.new(0.2, 0.2, 0.2)
    ring.Transparency = 1
    ring.Anchored = false
    ring.CanCollide = false
    ring.CanTouch = false
    ring.CanQuery = false
    ring.Parent = auraFolder
    local weld = Instance.new("WeldConstraint")
    weld.Part0, weld.Part1 = root, ring
    weld.Parent = ring
    table.insert(auraObjects, ring)

    local emitter = Instance.new("ParticleEmitter")
    emitter.Name = style .. "Particles"
    emitter.Color = ColorSequence.new(def[1], def[2])
    emitter.Texture = "rbxassetid://296874871"
