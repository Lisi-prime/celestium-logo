--// Movement protection + local fling/fly modes
local flingSpin = 0
local flyPlayerSpeed = 90

local function restoreMovementState()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    if hum then
        hum.AutoRotate = true
        hum.PlatformStand = false
    end
end

local function applyAntiFling()
    if not Toggles.AntiFling then return end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root then return end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    if hum then
        hum.AutoRotate = false
        hum.PlatformStand = false
    end
end

local function localWalkFlingStep()
    if not Toggles.WalkFling then return end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    flingSpin = (flingSpin + 48) % 360
    root.AssemblyAngularVelocity = Vector3.new(0, math.rad(flingSpin * 12), 0)
    root.AssemblyLinearVelocity = root.CFrame.LookVector * 80 + Vector3.new(0, 12, 0)
end

local function localFlyFlingStep()
    if not Toggles.FlyFling then return end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local cam = workspace.CurrentCamera
    local dir = cam and cam.CFrame.LookVector or root.CFrame.LookVector
    flingSpin = (flingSpin + 60) % 360
    root.AssemblyAngularVelocity = Vector3.new(
        math.rad(flingSpin * 10),
        math.rad(flingSpin * 14),
        math.rad(flingSpin * 8)
    )
    root.AssemblyLinearVelocity = dir * flyPlayerSpeed + Vector3.new(0, 30, 0)
end

local function localFlyPlayerStep()
    if not Toggles.FlyPlayer then return end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local cam = workspace.CurrentCamera
    if not cam then return end

    local move = Vector3.zero
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += cam.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= cam.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= cam.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += cam.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.yAxis end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.yAxis end

    if move.Magnitude > 0 then
        root.AssemblyLinearVelocity = move.Unit * flyPlayerSpeed
    else
        root.AssemblyLinearVelocity = Vector3.zero
    end
    root.AssemblyAngularVelocity = Vector3.zero
end

RunService.Heartbeat:Connect(function()
    if Toggles.AntiFling then applyAntiFling() end
    if Toggles.WalkFling then localWalkFlingStep() end
    if Toggles.FlyFling then localFlyFlingStep() end
    if Toggles.FlyPlayer then localFlyPlayerStep() end
end)

