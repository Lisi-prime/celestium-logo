local function rebuildCoinCache()
    local mapFolder = workspace:FindFirstChild("Map")
    if not mapFolder then
        cachedMapFolder = nil
        cachedCoinParts = {}
        return
    end
    cachedMapFolder = mapFolder
    local result = {}
    for _, item in ipairs(mapFolder:GetDescendants()) do
        if item.Name == "Coin" and item:IsA("BasePart") then
            result[#result + 1] = item
        elseif item.Name == "CoinContainer" then
            local part = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart")
            if part then result[#result + 1] = part end
        end
    end
    cachedCoinParts = result
    coinScanStamp = os.clock()
end

local function getCoinList()
    local map = workspace:FindFirstChild("Map")
    if cachedMapFolder ~= map or os.clock() - coinScanStamp > 2 then
        rebuildCoinCache()
    end
    local valid = {}
    for _, coin in ipairs(cachedCoinParts) do
        if coin and coin.Parent and coin:IsA("BasePart") then
            valid[#valid + 1] = coin
        end
    end
    cachedCoinParts = valid
    return valid
end

local function updateFarmCounter()
    if farmCounterLabel and farmCounterLabel.Parent then
        farmCounterLabel.Text = L("CoinsFarmed") .. tostring(coinsFarmed)
    end
end

local function tweenFlyTo(root, targetPosition, speed)
    if not root or not root.Parent then return false end
    local distance = (root.Position - targetPosition).Magnitude
    if distance < 2 then return true end

    local duration = math.max(distance / math.max(speed, 1), 0.04)
    local tween = TweenService:Create(
        root,
        TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
        {CFrame = CFrame.new(targetPosition + Vector3.new(0, 1.8, 0))}
    )
    tween:Play()
    tween.Completed:Wait()
    return true
end

local function startTweenFlyFarm()
    if farmBusy then return end
    farmBusy = true
    farmRunId += 1
    local myRun = farmRunId

    task.spawn(function()
        while Toggles.AutoCoins and myRun == farmRunId and celestialGui and celestialGui.Parent do
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root then
                task.wait(0.15)
                continue
            end

            local coins = getCoinList()
            table.sort(coins, function(a,b)
                if not a or not b then return false end
                return (root.Position-a.Position).Magnitude < (root.Position-b.Position).Magnitude
            end)

            local moved = false
            for _, coin in ipairs(coins) do
                if not Toggles.AutoCoins or myRun ~= farmRunId then break end
                if coin and coin.Parent then
                    moved = true
                    local before = coin.Parent
                    tweenFlyTo(root, coin.Position, SliderValues.FarmSpeed)
                    if coin.Parent == before and coin.Parent then
                        pcall(function()
                            firetouchinterest(root, coin, 0)
                            firetouchinterest(root, coin, 1)
                        end)
                    end
                    if not lastCoinTouch[coin] or os.clock() - lastCoinTouch[coin] > 0.5 then
                        lastCoinTouch[coin] = os.clock()
                        coinsFarmed += 1
                        updateFarmCounter()
                    end
                end
            end

            if not moved then
                task.wait(0.15)
            else
                task.wait()
            end
        end
        farmBusy = false
    end)
end

local function stopTweenFlyFarm()
    farmRunId += 1
    farmBusy = false
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

RunService.Heartbeat:Connect(function(deltaTime)
    local char = player.Character
    if not char then return end

    if Toggles.SpeedBoost then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = 24 end
    end

    if Toggles.NoClip and os.clock() - lastNoClipTime >= 0.10 then
        lastNoClipTime = os.clock()
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end

    lastEspUpdateTime += deltaTime
    if lastEspUpdateTime >= 0.50 then
        lastEspUpdateTime = 0
        updateESP()
    end

    if Toggles.ESPGunDrop then
        local drop = findGunDrop()
        if drop then addGunDropESP(drop) else removeGunDropESP() end
    elseif CurrentHighlight or CurrentBillboard then
        removeGunDropESP()
    end

    local root = char:FindFirstChild("HumanoidRootPart")
    if Toggles.AutoGrabGun and root and os.clock() - lastGunGrabTime >= 0.15 then
        local drop = findGunDrop()
        if drop then
            lastGunGrabTime = os.clock()
            grabGun(drop)
        end
    end

    lastStepTime += deltaTime
    if lastStepTime < 0.066 then return end
    lastStepTime = 0

    local backpack = player:FindFirstChildOfClass("Backpack")
    local knife = char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife"))

    if knife and os.clock() - lastCombatTime >= 0.10 then
        lastCombatTime = os.clock()
        if Toggles.KillAll then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player then attackTarget(p, knife) end
            end
        elseif Toggles.KillOnlySheriff then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player and getMM2Role(p) == "Sheriff" then attackTarget(p, knife) end
            end
        elseif Toggles.KillAura and root then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    if (root.Position - p.Character.HumanoidRootPart.Position).Magnitude <= 18 then
                        attackTarget(p, knife)
                    end
                end
            end
        end
    end

    if os.clock() - lastAuraTime >= 0.25 then
        lastAuraTime = os.clock()
        updateAura()
    end

    if Toggles.RainbowCharacter and os.clock() - lastRainbowTime >= 0.08 then
        lastRainbowTime = os.clock()
        local hue = (os.clock() * 0.25) % 1
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Transparency < 1 and not part:GetAttribute("CelestialOriginalColor") then
                part:SetAttribute("CelestialOriginalColor", part.Color)
            end
            if part:IsA("BasePart") and part.Transparency < 1 then
                part.Color = Color3.fromHSV((hue + part.Position.Y * 0.002) % 1, 0.75, 1)
                part:SetAttribute("CelestialRainbow", true)
            end
        end
    end
end)

