local roleOrder = {Murderer = 1, Sheriff = 2, Hero = 2, Innocent = 3, Dead = 4}

local function roleDisplay(role)
    if role == "Murderer" then return "🔪 Murderer", Color3.fromRGB(255, 75, 75)
    elseif role == "Sheriff" then return "🔫 Sheriff", Color3.fromRGB(80, 160, 255)
    elseif role == "Hero" then return "⭐ Hero", Color3.fromRGB(255, 205, 70)
    elseif role == "Dead" then return "💀 Dead", Color3.fromRGB(130, 130, 145)
    else return "👤 Innocent", Color3.fromRGB(170, 175, 190) end
end

local function flingTarget(target)
    if not target or target == player then return end
    local char = target.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- Local physics impulse; the server may override it when it owns the target.
    pcall(function()
        local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        local dir = myRoot and (root.Position - myRoot.Position).Unit or Vector3.new(0,1,0)
        root.AssemblyLinearVelocity = dir * 180 + Vector3.new(0, 240, 0)
        root.AssemblyAngularVelocity = Vector3.new(90, 220, 90)
    end)
end

local function rebuildPlayerList()
    for _, child in ipairs(playerScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local roster = {}
    for _, p in ipairs(Players:GetPlayers()) do
        local role = getMM2Role(p)
        roster[#roster + 1] = {Player = p, Role = role, Order = roleOrder[role] or 3}
    end

    table.sort(roster, function(a, b)
        if a.Order ~= b.Order then return a.Order < b.Order end
        return a.Player.Name:lower() < b.Player.Name:lower()
    end)

    for index, entry in ipairs(roster) do
        local target = entry.Player
        local roleText, roleColor = roleDisplay(entry.Role)

        local item = Instance.new("TextButton")
        item.Name = "Player_" .. target.UserId
        item.LayoutOrder = index
        item.Size = UDim2.new(1, -4, 0, 42)
        item.BackgroundColor3 = Color3.fromRGB(27, 28, 35)
        item.BackgroundTransparency = 0.08
        item.AutoButtonColor = false
        item.Text = ""
        item.Parent = playerScroll

        local corner = Instance.new("UICorner", item)
        corner.CornerRadius = UDim.new(0, 7)
        local stroke = Instance.new("UIStroke", item)
        stroke.Color = roleColor
        stroke.Transparency = 0.72

        local avatar = Instance.new("ImageLabel")
        avatar.Size = UDim2.new(0, 32, 0, 32)
        avatar.Position = UDim2.new(0, 5, 0.5, -16)
        avatar.BackgroundTransparency = 1
        avatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. target.UserId .. "&w=150&h=150"
        avatar.Parent = item
        local avatarCorner = Instance.new("UICorner", avatar)
        avatarCorner.CornerRadius = UDim.new(1, 0)

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, -48, 0, 16)
        nameLabel.Position = UDim2.new(0, 43, 0, 4)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = target.DisplayName ~= target.Name and (target.DisplayName .. "  @" .. target.Name) or target.Name
        nameLabel.TextColor3 = Color3.fromRGB(230, 232, 240)
        nameLabel.TextSize = 10
        nameLabel.Font = Enum.Font.GothamMedium
        nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
        nameLabel.TextXAlignment = Enum.TextXAlignment.Left
        nameLabel.Parent = item

        local roleLabel = Instance.new("TextLabel")
        roleLabel.Size = UDim2.new(1, -48, 0, 14)
        roleLabel.Position = UDim2.new(0, 43, 0, 21)
        roleLabel.BackgroundTransparency = 1
        roleLabel.Text = roleText
        roleLabel.TextColor3 = roleColor
        roleLabel.TextSize = 9
        roleLabel.Font = Enum.Font.GothamBold
        roleLabel.TextXAlignment = Enum.TextXAlignment.Left
        roleLabel.Parent = item

        item.MouseEnter:Connect(function()
            TweenService:Create(item, TweenInfo.new(0.12), {BackgroundColor3 = roleColor:Lerp(Color3.fromRGB(25,25,30), 0.72)}):Play()
        end)
        item.MouseLeave:Connect(function()
            TweenService:Create(item, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(27,28,35)}):Play()
        end)
        item.MouseButton1Click:Connect(function()
            flingTarget(target)
        end)
    end
end

