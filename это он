local function removeESP(p)
    local highlight = Highlights[p]
    if highlight then highlight:Destroy(); Highlights[p] = nil end
    local bill = ESPBillboards[p]
    if bill then bill:Destroy(); ESPBillboards[p] = nil end
    local tracer = ESPTracers[p]
    if tracer then tracer:Destroy(); ESPTracers[p] = nil end
end

local function addESP(p, role)
    if p == player or not Toggles.ESPRoles then
        removeESP(p)
        return
    end

    local character = p.Character
    if not character then
        removeESP(p)
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        removeESP(p)
        return
    end

    local color = ROLE_COLORS[role]
    if not color then
        removeESP(p)
        return
    end

    local highlight = Highlights[p]
    if highlight and highlight.Parent ~= character then
        highlight:Destroy()
        highlight = nil
        Highlights[p] = nil
    end

    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "MM2RoleESP"
        highlight.Adornee = character
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 0.45
        highlight.OutlineTransparency = 0
        highlight.Parent = character
        Highlights[p] = highlight
    end

    highlight.FillColor = color
    highlight.OutlineColor = color

    local root = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
    if ESPSettings.ShowName or ESPSettings.ShowDistance then
        local bill = ESPBillboards[p]
        if not bill or bill.Adornee ~= root then
            if bill then bill:Destroy() end
            bill = Instance.new("BillboardGui")
            bill.Name = "CelestialRoleInfo"
            bill.Size = UDim2.fromOffset(150, 32)
            bill.StudsOffset = Vector3.new(0, 3.1, 0)
            bill.AlwaysOnTop = true
            bill.MaxDistance = 10000
            bill.Adornee = root
            bill.Parent = character
            local text = Instance.new("TextLabel")
            text.Name = "Info"
            text.Size = UDim2.fromScale(1,1)
            text.BackgroundTransparency = 1
            text.TextScaled = false
            text.TextSize = 12
            text.Font = Enum.Font.GothamBold
            text.TextStrokeTransparency = 0
            text.TextStrokeColor3 = Color3.new(0,0,0)
            text.Parent = bill
            ESPBillboards[p] = bill
        end
        local text = bill:FindFirstChild("Info")
        if text then
            local parts = {}
            if ESPSettings.ShowName then table.insert(parts, p.DisplayName) end
            if ESPSettings.ShowDistance and root then
                local myRoot = getCharacterRoot and getCharacterRoot(player) or (player.Character and player.Character:FindFirstChild("HumanoidRootPart"))
                if myRoot then table.insert(parts, string.format("[%dm]", math.floor((myRoot.Position-root.Position).Magnitude))) end
            end
            text.Text = table.concat(parts, " ")
            text.TextColor3 = color
        end
    else
        local bill = ESPBillboards[p]
        if bill then bill:Destroy(); ESPBillboards[p] = nil end
    end
end

local function ensureESPTracerGui()
    if ESPTracerGui and ESPTracerGui.Parent then return ESPTracerGui end
    ESPTracerGui = Instance.new("ScreenGui")
    ESPTracerGui.Name = "CelestialESPTracers"
    ESPTracerGui.ResetOnSpawn = false
    ESPTracerGui.IgnoreGuiInset = true
    ESPTracerGui.DisplayOrder = 20
    ESPTracerGui.Parent = playerGui
    return ESPTracerGui
end

local function updateESPTracers()
    if not Toggles.ESPRoles or not ESPSettings.ShowTracers then
        for p, line in pairs(ESPTracers) do if line then line:Destroy() end ESPTracers[p]=nil end
        return
    end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local gui = ensureESPTracerGui()
    local viewport = cam.ViewportSize
    local origin = Vector2.new(viewport.X*0.5, viewport.Y*0.5)
    for p, _ in pairs(Highlights) do
        local root = p.Character and (p.Character:FindFirstChild("HumanoidRootPart") or p.Character:FindFirstChild("Head"))
        if root then
            local pos, onScreen = cam:WorldToViewportPoint(root.Position)
            local line = ESPTracers[p]
            if not line then
                line=Instance.new("Frame")
                line.Name="Tracer"
                line.AnchorPoint=Vector2.new(0,0.5)
                line.BorderSizePixel=0
                line.Size=UDim2.fromOffset(1,1)
                line.Parent=gui
                ESPTracers[p]=line
            end
            line.BackgroundColor3 = ROLE_COLORS[RoleCache[p] and RoleCache[p].Role] or Color3.new(1,1,1)
            line.Visible = onScreen and pos.Z > 0
            if line.Visible then
                local target=Vector2.new(pos.X,pos.Y)
                local delta=target-origin
                local length=math.min(delta.Magnitude, math.max(viewport.X,viewport.Y))
                line.Position=UDim2.fromOffset(origin.X,origin.Y)
                line.Size=UDim2.fromOffset(length,1.5)
                line.Rotation=math.deg(math.atan2(delta.Y,delta.X))
            end
        end
    end
end

local function updateESP()
    if not Toggles.ESPRoles then
        for p, _ in pairs(Highlights) do
            removeESP(p)
        end
        return
    end

    local remote = GetPlayerData
    if not remote then
        return
    end

    local success, playerData = pcall(function()
        return remote:InvokeServer()
    end)

    if not success or type(playerData) ~= "table" then
        return
    end

    RoleCache = {}
    RoleCacheTime = os.clock()

    for _, p in ipairs(Players:GetPlayers()) do
        if p == player then
            removeESP(p)
            continue
        end

        local data = playerData[p.Name]
        if type(data) ~= "table" then
            removeESP(p)
            continue
        end

        local role = data.Role
        local dead = data.Dead
        RoleCache[p] = {Role = role, Dead = dead}

        if dead == true then
            removeESP(p)
        else
            addESP(p, role)
        end
    end

    for p, highlight in pairs(Highlights) do
        if not p.Parent then
            if highlight then
                highlight:Destroy()
            end
            Highlights[p] = nil
        end
    end
end

