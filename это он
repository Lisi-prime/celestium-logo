    end
end

local function startAntiFling()
    if antiFlingConnection then
        antiFlingConnection:Disconnect()
    end

    Toggles.AntiFling = true

    -- Source logic: on every Stepped, disable collisions on every other player's
    -- character part so their physics cannot push/fling the local character.
    antiFlingConnection = RunService.Stepped:Connect(function()
        if not Toggles.AntiFling then return end

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character then
                for _, part in ipairs(plr.Character:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end
    end)
end

