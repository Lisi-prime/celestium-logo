    label.Font = Enum.Font.Gotham
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = sliderItem

    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0, 40, 0, 18)
    valueLabel.Position = UDim2.new(1, -46, 0, 0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = string.format("%." .. tostring(decimals or 1) .. "f", SliderValues[sliderKey] or default)
    valueLabel.TextColor3 = Color3.fromRGB(120, 160, 255)
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.TextSize = 12
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Parent = sliderItem

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -12, 0, 6)
    track.Position = UDim2.new(0, 6, 0, 28)
    track.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    track.Parent = sliderItem

    local trackCorner = Instance.new("UICorner", track)
    trackCorner.CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    local curVal = SliderValues[sliderKey] or default
    local startPct = (curVal - min) / (max - min)
    fill.Size = UDim2.new(startPct, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(120, 160, 255)
    fill.Parent = track

    local fillCorner = Instance.new("UICorner", fill)
    fillCorner.CornerRadius = UDim.new(1, 0)

    local dragging = false

    local function updateValue(input)
        local pos = input.Position.X - track.AbsolutePosition.X
        local pct = math.clamp(pos / track.AbsoluteSize.X, 0, 1)
        local val = min + (max - min) * pct
        if decimals and decimals == 0 then
            val = math.floor(val + 0.5)
        else
            local mult = 10 ^ (decimals or 1)
            val = math.floor(val * mult + 0.5) / mult
        end
        fill.Size = UDim2.new(pct, 0, 1, 0)
        valueLabel.Text = string.format("%." .. tostring(decimals or 1) .. "f", val)
        SliderValues[sliderKey] = val
        if Toggles.AutoSaveConfig then saveConfig() end
        if callback then callback(val) end
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateValue(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateValue(input)
        end
    end)
end

