            local success, result = pcall(function() return readfile(configFileName) end)
            if success then
                local decodedSuccess, decodedData = pcall(function() return HttpService:JSONDecode(result) end)
                if decodedSuccess and type(decodedData) == "table" then
                    if decodedData.Toggles then
                        for k, v in pairs(decodedData.Toggles) do Toggles[k] = v end
                        if decodedData.Toggles.SpeedBoost ~= nil and decodedData.Toggles.WalkSpeed == nil then
                            Toggles.WalkSpeed = decodedData.Toggles.SpeedBoost
                        end
                        if decodedData.Toggles.FlyPlayer ~= nil and decodedData.Toggles.Fly == nil then
                            Toggles.Fly = decodedData.Toggles.FlyPlayer
                        end
                    end
                    if decodedData.Sliders then
                        for k, v in pairs(decodedData.Sliders) do SliderValues[k] = v end
                    end
                    if decodedData.FeatureBinds then
                        for k, v in pairs(decodedData.FeatureBinds) do
                            if type(v) == "string" and Enum.KeyCode[v] then FeatureBinds[k] = Enum.KeyCode[v] end
                        end
                    end
                    if decodedData.ESPSettings then
                        for k, v in pairs(decodedData.ESPSettings) do ESPSettings[k] = v end
                    end
                    if decodedData.Language then currentLanguage = decodedData.Language end
                    if decodedData.MenuKey then
                        pcall(function() currentMenuKey = Enum.KeyCode[decodedData.MenuKey] end)
                    end
                    if decodedData.ThemeName then currentThemeName = decodedData.ThemeName end
                end
            end
        end
    end
end

local function saveConfig()
    if writefile then
        local success, encoded = pcall(function() 
            return HttpService:JSONEncode({
                Toggles = Toggles, 
                Sliders = SliderValues,
                FeatureBinds = {
                    NoClip = FeatureBinds.NoClip and FeatureBinds.NoClip.Name or nil,
                    KillAura = FeatureBinds.KillAura and FeatureBinds.KillAura.Name or nil,
                    KillAll = FeatureBinds.KillAll and FeatureBinds.KillAll.Name or nil
                },
                ESPSettings = ESPSettings,
                Language = currentLanguage,
                MenuKey = currentMenuKey.Name,
                ThemeName = currentThemeName
            }) 
        end)
        if success then writefile(configFileName, encoded) end
    end
end

