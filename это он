RunService.Heartbeat:Connect(function(deltaTime)
    local char = player.Character
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        if Toggles.WalkSpeed then hum.WalkSpeed = SliderValues.WalkSpeed or 24 end
        if Toggles.JumpPower then hum.UseJumpPower = true; hum.JumpPower = SliderValues.JumpPower or 50 end
    end

    if Toggles.NoClip and os.clock() - lastNoClipTime >= 0.10 then
        lastNoClipTime = os.clock()
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end

    lastEspUpdateTime += deltaTime
    if lastEspUpdateTime >= 0.50 then
        lastEspUpdateTime = 0
        updateESP()
    end
    ESPTracerUpdate += deltaTime
    if ESPTracerUpdate >= 0.06 then
        ESPTracerUpdate = 0
        updateESPTracers()
    end

    if Toggles.ESPGunDrop then
        local drop = findGunDrop()
        if drop then addGunDropESP(drop) else removeGunDropESP() end
    elseif CurrentHighlight or CurrentBillboard then
        removeGunDropESP()
    end

    local root = char:FindFirstChild("HumanoidRootPart")
    if Toggles.AutoGrabGun and root and os.clock() - lastGunGrabTime >= 0.15 then
        local drop = findGunDrop()
        if drop then
            lastGunGrabTime = os.clock()
            grabGun(drop)
        end
    end

    lastStepTime += deltaTime
    if lastStepTime < 0.066 then return end
    lastStepTime = 0

    local backpack = player:FindFirstChildOfClass("Backpack")
    local knife = char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife"))

    if knife and os.clock() - lastCombatTime >= 0.10 then
        lastCombatTime = os.clock()
        if Toggles.KillAll then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player then attackTarget(p, knife) end
            end
        elseif Toggles.KillOnlySheriff then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player and getMM2Role(p) == "Sheriff" then attackTarget(p, knife) end
            end
        elseif Toggles.KillAura and root then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    if (root.Position - p.Character.HumanoidRootPart.Position).Magnitude <= (SliderValues.KillAuraDistance or 18) then
                        attackTarget(p, knife)
                    end
                end
            end
        end
    end

    if os.clock() - lastAuraTime >= 0.25 then
        lastAuraTime = os.clock()
        updateAura()
    end

    if Toggles.RainbowCharacter and os.clock() - lastRainbowTime >= 0.08 then
        lastRainbowTime = os.clock()
        local hue = (os.clock() * 0.25) % 1
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Transparency < 1 and not part:GetAttribute("CelestialOriginalColor") then
                part:SetAttribute("CelestialOriginalColor", part.Color)
            end
            if part:IsA("BasePart") and part.Transparency < 1 then
                part.Color = Color3.fromHSV((hue + part.Position.Y * 0.002) % 1, 0.75, 1)
                part:SetAttribute("CelestialRainbow", true)
            end
        end
    end
end)

