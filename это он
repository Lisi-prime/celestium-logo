local function sendFlingCommand(username)
    local command = "fling " .. tostring(username)

    -- Modern Roblox chat.
    local ok = pcall(function()
        local TextChatService = game:GetService("TextChatService")
        local channels = TextChatService:FindFirstChild("TextChannels")
        local general = channels and (channels:FindFirstChild("RBXGeneral") or channels:FindFirstChildWhichIsA("TextChannel"))
        if not general then error("No TextChannel") end
        general:SendAsync(command)
    end)
    if ok then return true end

    -- Legacy Roblox chat.
    local sent = pcall(function()
        local events = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
        local say = events and events:FindFirstChild("SayMessageRequest")
        if not say then error("No SayMessageRequest") end
        say:FireServer(command, "All")
    end)
    return sent
end

local function flingTarget(target)
    if not target or target == player then return end

    -- The source workflow is: fling + player nickname.
    if sendFlingCommand(target.Name) then
        return
    end

    -- Fallback when the place/executor has no usable chat command channel.
    if selectedFlingConnection then
        selectedFlingConnection:Disconnect()
        selectedFlingConnection = nil
    end

    local root = getCharacterRoot(player)
    local targetRoot = getCharacterRoot(target)
    if not root or not targetRoot then return end

    local started = os.clock()
    selectedFlingConnection = RunService.Heartbeat:Connect(function()
        if os.clock() - started > 1.5 or not root.Parent or not targetRoot.Parent then
            if selectedFlingConnection then
                selectedFlingConnection:Disconnect()
                selectedFlingConnection = nil
            end
            return
        end

        flingSpin = (flingSpin + 70) % 360
        root.CFrame =
            targetRoot.CFrame
            * CFrame.new(0, 0, 2.5)
            * CFrame.Angles(math.rad(flingSpin), math.rad(flingSpin * 1.5), math.rad(flingSpin * 2))

        root.AssemblyAngularVelocity = Vector3.new(0, 99999, 0)
        root.AssemblyLinearVelocity = Vector3.new(0, 99999, 0)
    end)
end

function applyFlingFeatureState(featureKey, state)
    if featureKey == "AntiFling" then
        if state then startAntiFling() else stopAntiFling() end
    elseif featureKey == "WalkFling" then
        if state then startWalkFling() else stopWalkFling() end
    elseif featureKey == "Fly" then
        if state then startFly() else stopFly() end
    end
end

RunService.Heartbeat:Connect(function()
    if Toggles.AntiFling and not antiFlingConnection then
        startAntiFling()
    end
    if Toggles.WalkFling and not walkFlingConnection then
        startWalkFling()
    end
    if Toggles.Fly and not flyConnection then
        startFly()
    end
end)

player.CharacterAdded:Connect(function()
    task.wait(0.25)
    if Toggles.AntiFling then startAntiFling() end
    if Toggles.WalkFling then startWalkFling() end
    if Toggles.Fly then startFly() end
end)
