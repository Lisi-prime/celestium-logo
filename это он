    flyLastControls = {Q = 0, E = 0}
end

local function stopFly()
    Toggles.Fly = false
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
    disconnectFlyInput()
    local root = getCharacterRoot(player)
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if root then
        local bv = root:FindFirstChild("CelestiumFlyVelocity")
        local bg = root:FindFirstChild("CelestiumFlyGyro")
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
        root.AssemblyLinearVelocity = Vector3.zero
    end
    if hum then hum.PlatformStand = false end
end

local function startFly()
    stopFly()
    Toggles.Fly = true
    local root = getCharacterRoot(player)
    if not root then return end
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    local bv = Instance.new("BodyVelocity")
    bv.Name = "CelestiumFlyVelocity"
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Velocity = Vector3.zero
    bv.Parent = root
    local bg = Instance.new("BodyGyro")
    bg.Name = "CelestiumFlyGyro"
    bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.P = 9e4
    bg.CFrame = workspace.CurrentCamera and workspace.CurrentCamera.CFrame or root.CFrame
    bg.Parent = root
    if hum then hum.PlatformStand = true end

    local mouse = player:GetMouse()
    flyKeyDown = mouse.KeyDown:Connect(function(key)
        key = key:lower()
        if key == "w" then flyControls.F = flyPlayerSpeed
        elseif key == "s" then flyControls.B = -flyPlayerSpeed
        elseif key == "a" then flyControls.L = -flyPlayerSpeed
        elseif key == "d" then flyControls.R = flyPlayerSpeed
        elseif key == "e" then flyControls.Q = flyPlayerSpeed * 2
        elseif key == "q" then flyControls.E = -flyPlayerSpeed * 2 end
    end)
    flyKeyUp = mouse.KeyUp:Connect(function(key)
        key = key:lower()
        if key == "w" or key == "s" then flyControls.F = 0; flyControls.B = 0
        elseif key == "a" or key == "d" then flyControls.L = 0; flyControls.R = 0
        elseif key == "e" then flyControls.Q = 0
        elseif key == "q" then flyControls.E = 0 end
    end)

    flyConnection = RunService.RenderStepped:Connect(function()
        if not Toggles.Fly or not root.Parent then stopFly(); return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local move = (cam.CFrame.LookVector * (flyControls.F - flyControls.B))
            + (cam.CFrame.RightVector * (flyControls.R - flyControls.L))
            + (cam.CFrame.UpVector * (flyControls.Q + flyControls.E))
        if move.Magnitude > 0 then
            bv.Velocity = move.Unit * 50
            flyLastControls.Q = flyControls.Q
            flyLastControls.E = flyControls.E
        else
            bv.Velocity = Vector3.zero
        end
        bg.CFrame = cam.CFrame
    end)
end

