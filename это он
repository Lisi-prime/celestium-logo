local function grabGun(gunDrop)
    local character = player.Character
    if not character or not gunDrop then return end

    local root = character:FindFirstChild("HumanoidRootPart")
    if not root or not root:IsA("BasePart") then return end
    if not root:IsDescendantOf(workspace) or not gunDrop:IsDescendantOf(workspace) then return end

    local target = gunDrop
    if not target:IsA("BasePart") then
        target = gunDrop:FindFirstChildWhichIsA("BasePart", true)
    end
    if not target or not target:IsDescendantOf(workspace) then return end

    pcall(function()
        firetouchinterest(root, target, 0)
        firetouchinterest(root, target, 1)
    end)
end

