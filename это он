local function startWalkFling()
    if walkFlingConnection then walkFlingConnection:Disconnect() end
    Toggles.WalkFling = true
    walkFlingConnection = RunService.Heartbeat:Connect(function()
        if not Toggles.WalkFling then return end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local originalVelocity = root.Velocity
        root.Velocity = originalVelocity * 10000 + Vector3.new(0, 10000, 0)
        RunService.RenderStepped:Wait()
        if root.Parent then root.Velocity = originalVelocity end
        RunService.Stepped:Wait()
        if root.Parent then root.Velocity = originalVelocity + Vector3.new(0, 0.1, 0) end
    end)
end

local function stopAntiFling()
    Toggles.AntiFling = false
    if antiFlingConnection then
        antiFlingConnection:Disconnect()
        antiFlingConnection = nil
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            for _, part in ipairs(plr.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
