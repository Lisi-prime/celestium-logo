function collectCoin(root, coin)
    if not root or not root.Parent or not coin or not coin.Parent then return false end

    -- MM2 uses Coin_Server/Coin objects inside CoinContainer. Move directly
    -- onto the coin and fire touch immediately instead of waiting for a long tween.
    pcall(function()
        root.CFrame = coin.CFrame + Vector3.new(0, 1.5, 0)
        firetouchinterest(root, coin, 0)
        firetouchinterest(root, coin, 1)
    end)

    local visual = coin:FindFirstChild("CoinVisual")
    if visual and visual:GetAttribute("Collected") == true then
        return true
    end

    return coin.Parent == nil
end

function startTweenFlyFarm()
    if farmBusy then return end
    farmBusy = true
    farmRunId += 1
    local myRun = farmRunId

    task.spawn(function()
        while Toggles.AutoCoins and myRun == farmRunId and celestialGui and celestialGui.Parent do
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if not root or not hum or hum.Health <= 0 then
                task.wait(0.05)
                continue
            end

            local coins = getCoinList()
            if #coins == 0 then
                rebuildCoinCache()
                coins = getCoinList()
            end

            table.sort(coins, function(a, b)
                if not a or not a.Parent then return false end
                if not b or not b.Parent then return true end
                return (root.Position - a.Position).Magnitude < (root.Position - b.Position).Magnitude
            end)

            local collectedAny = false
            for _, coin in ipairs(coins) do
                if not Toggles.AutoCoins or myRun ~= farmRunId then break end
                if coin and coin.Parent then
                    local before = coin.Parent
                    local beforeVisual = coin:FindFirstChild("CoinVisual")
                    local beforeCollected = beforeVisual and beforeVisual:GetAttribute("Collected") == true

                    collectCoin(root, coin)

                    local afterVisual = coin.Parent and coin:FindFirstChild("CoinVisual")
                    local collected = (not coin.Parent) or (afterVisual and afterVisual:GetAttribute("Collected") == true) or (beforeCollected == false and beforeVisual and beforeVisual.Parent == nil)

                    if collected or coin.Parent ~= before then
                        collectedAny = true
                        coinsFarmed += 1
                        updateFarmCounter()
                    end
                end
            end

            if not collectedAny then
                task.wait(0.08)
            else
                task.wait()
            end
        end
        farmBusy = false
    end)
end

function stopTweenFlyFarm()
