function attackTarget(targetPlayer, knife)
    if not targetPlayer or not targetPlayer.Character then return end
    local enemyRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    local enemyHum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
    local myChar = player.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    if enemyRoot and enemyHum and enemyHum.Health > 0 and myRoot then
        if knife.Parent ~= myChar then
            knife.Parent = myChar
        end

        pcall(function()
            knife:Activate()

            local stabEvent = knife:FindFirstChild("Stab") or knife:FindFirstChild("Slash")
            if stabEvent and stabEvent:IsA("RemoteEvent") then
                stabEvent:FireServer()
            end

            local handle = knife:FindFirstChild("Handle")
            if handle then
                firetouchinterest(handle, enemyRoot, 0)
                firetouchinterest(handle, enemyRoot, 1)
            end
        end)
    end
end

