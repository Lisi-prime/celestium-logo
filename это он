function rebuildCoinCache()
    cachedMapFolder = workspace:FindFirstChild("Map")
    cachedCoinParts = {}
    if not cachedMapFolder then return end

    local seen = {}
    for _, item in ipairs(cachedMapFolder:GetDescendants()) do
        local coin = nil

        if item.Name == "Coin_Server" and item:IsA("BasePart") then
            coin = item
        elseif item.Name == "Coin" and item:IsA("BasePart") then
            coin = item
        elseif item.Name == "CoinContainer" then
            for _, child in ipairs(item:GetDescendants()) do
                if child:IsA("BasePart") and (child.Name == "Coin_Server" or child.Name == "Coin") then
                    coin = child
                    if not seen[coin] then
                        seen[coin] = true
                        cachedCoinParts[#cachedCoinParts + 1] = coin
                    end
                end
            end
        end

        if coin and not seen[coin] then
            seen[coin] = true
            cachedCoinParts[#cachedCoinParts + 1] = coin
        end
    end

    coinScanStamp = os.clock()
end

function getCoinList()
    local map = workspace:FindFirstChild("Map")
    if cachedMapFolder ~= map or os.clock() - coinScanStamp > 0.75 then
        rebuildCoinCache()
    end

    local valid = {}
    for _, coin in ipairs(cachedCoinParts) do
        if coin and coin.Parent and coin:IsA("BasePart") then
            local visual = coin:FindFirstChild("CoinVisual")
            if not visual or visual:GetAttribute("Collected") ~= true then
                valid[#valid + 1] = coin
            end
        end
    end
    cachedCoinParts = valid
    return valid
end

