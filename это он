local function utf8Lower(str)
    local upper = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ"
    local lower = "абвгдеёжзийкламнопрстуфхцучшщъыьэюяabcdefghijklmnopqrstuvwxyz"
    local result = ""
    for char in string.gmatch(str, "[%z\1-\127\194-\244][\128-\191]*") do
        local pos = string.find(upper, char, 1, true)
        if pos then result = result .. string.sub(lower, pos, pos + (#char - 1))
        else result = result .. char end
    end
    return result
end

