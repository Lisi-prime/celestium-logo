local function getMM2Role(p)
    local cached = RoleCache[p]
    if cached and (os.clock() - RoleCacheTime) < 1.0 then
        if cached.Dead then return "Dead" end
        return cached.Role or "Innocent"
    end

    -- Fallback only when the role cache is not available.
    local char = p.Character
    if not char then return "Innocent" end
    local backpack = p:FindFirstChildOfClass("Backpack")
    local hasKnife = char:FindFirstChild("Knife") ~= nil or (backpack and backpack:FindFirstChild("Knife") ~= nil)
    local hasGun = char:FindFirstChild("Gun") ~= nil or char:FindFirstChild("Revolver") ~= nil
        or (backpack and (backpack:FindFirstChild("Gun") ~= nil or backpack:FindFirstChild("Revolver") ~= nil))
    if hasKnife then return "Murderer" end
    if hasGun then return "Sheriff" end
    return "Innocent"
end
