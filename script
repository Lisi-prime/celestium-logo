local function setAura(style)
    clearAura()
    local def = auraDefs[style]
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not def or not root then return end

    local ring = Instance.new("Part")
    ring.Name = "AuraCore"
    ring.Size = Vector3.new(0.2, 0.2, 0.2)
    ring.Transparency = 1
    ring.Anchored = false
    ring.CanCollide = false
    ring.CanTouch = false
    ring.CanQuery = false
    ring.Parent = auraFolder
    local weld = Instance.new("WeldConstraint")
    weld.Part0, weld.Part1 = root, ring
    weld.Parent = ring
    table.insert(auraObjects, ring)

    local emitter = Instance.new("ParticleEmitter")
    emitter.Name = style .. "Particles"
    emitter.Color = ColorSequence.new(def[1], def[2])
    emitter.Texture = "rbxassetid://296874871"
    emitter.Rate = 14
    emitter.Lifetime = NumberRange.new(0.8, 1.5)
    emitter.Speed = NumberRange.new(0.5, 2.2)
    emitter.SpreadAngle = Vector2.new(360, 360)
    emitter.Rotation = NumberRange.new(0, 360)
    emitter.RotSpeed = NumberRange.new(-90, 90)
    emitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(0.45, 1.7), NumberSequenceKeypoint.new(1, 0)})
    emitter.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1)})
    emitter.Parent = ring
    table.insert(auraObjects, emitter)

    local light = Instance.new("PointLight")
    light.Name = "AuraGlow"
    light.Color = def[2]
    light.Range = def[3]
    light.Brightness = def[4]
    light.Parent = root
    table.insert(auraObjects, light)
end

