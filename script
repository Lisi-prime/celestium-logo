local function roleDisplay(role)
    if role == "Murderer" then return "🔪 Murderer", Color3.fromRGB(255, 75, 75)
    elseif role == "Sheriff" then return "🔫 Sheriff", Color3.fromRGB(80, 160, 255)
    elseif role == "Hero" then return "⭐ Hero", Color3.fromRGB(255, 205, 70)
