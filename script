local function addSlider(container, textKey, min, max, default, decimals, sliderKey, callback)
    local sliderItem = Instance.new("Frame")
    sliderItem.Name = "SliderItem"
    sliderItem.Size = UDim2.new(1, 0, 0, 48)
    sliderItem.BackgroundTransparency = 1
    sliderItem.Parent = container

    local label = Instance.new("TextLabel")
    label.Name = "SliderLabel"
    label.Size = UDim2.new(1, -50, 0, 18)
    label.Position = UDim2.new(0, 6, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = L(textKey)
