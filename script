local clearAura
local resetRainbowCharacter

local function applyFeatureState(featureKey, state)
    if featureKey == "SpeedBoost" and not state then
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = 16 end
    elseif featureKey == "NoClip" and not state then
        local char = player.Character
        if char then
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then part.CanCollide = true end
            end
        end
    elseif featureKey == "AntiFling" and not state then
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.AutoRotate = true end
    elseif (featureKey == "GalaxyAura" or featureKey == "FrostAura" or featureKey == "VoidAura") and not state then
        clearAura()
    elseif featureKey == "RainbowCharacter" and not state then
        resetRainbowCharacter()
    elseif featureKey == "InfiniteJump" and not state then
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Running) end
    elseif featureKey == "ESPRoles" and not state then
        for _, p in ipairs(Players:GetPlayers()) do
            removeESP(p)
        end
    elseif featureKey == "ESPGunDrop" and not state then
        removeGunDropESP()
    elseif featureKey == "AutoCoins" and not state then
        stopTweenFlyFarm()
    elseif (featureKey == "WalkFling" or featureKey == "FlyFling" or featureKey == "FlyPlayer") and not state then
        restoreMovementState()
    end
end

