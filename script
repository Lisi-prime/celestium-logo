--// Логика MM2 Role ESP[cite: 1]
local GetPlayerData = nil

local function findGetPlayerData()
    if GetPlayerData and GetPlayerData.Parent and GetPlayerData:IsA("RemoteFunction") then
        return GetPlayerData
    end

    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local extras = remotes and remotes:FindFirstChild("Extras")
    local remote = extras and extras:FindFirstChild("GetPlayerData")

    if remote and remote:IsA("RemoteFunction") then
        GetPlayerData = remote
        return remote
    end

    local rootRemote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if rootRemote and rootRemote:IsA("RemoteFunction") then
        GetPlayerData = rootRemote
        return rootRemote
    end

    return nil
end

