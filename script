        if obj and obj.Parent then
            pcall(function()
                TweenService:Create(obj, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {[prop] = color}):Play()
            end)
        end
    end

    tweenColor(mainFrame, "BackgroundColor3", theme.MainBg)
    tweenColor(sideBar, "BackgroundColor3", theme.SidebarBg)
    tweenColor(contentArea, "BackgroundColor3", theme.CardBg)
    if playerListPanel then
        tweenColor(playerListPanel, "BackgroundColor3", theme.CardBg)
        tweenColor(playerListStroke, "Color", theme.CardStroke)
        tweenColor(playerListTitle, "TextColor3", theme.Accent)
    end
    tweenColor(frameStroke, "Color", theme.Accent)
    tweenColor(titleLabel, "TextColor3", theme.Accent)
    tweenColor(topToggleStroke, "Color", theme.Accent)
    for _, tabData in pairs(tabButtons) do
        tweenColor(tabData.Indicator, "BackgroundColor3", theme.Accent)
    end

    for _, obj in ipairs(canvasGroup:GetDescendants()) do
        if obj:IsA("UIStroke") then
            tweenColor(obj, "Color", theme.CardStroke)
        elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
            if obj.Name == "FeatureLabel" or obj.Name == "CardTitle" or obj.Name == "DropdownTitle" or obj.Name == "KeybindTitle" then
                tweenColor(obj, "TextColor3", theme.Secondary:Lerp(Color3.new(1,1,1), 0.55))
            elseif obj.Name == "ValueLabel" or obj.Name == "KeyLabel" then
                tweenColor(obj, "TextColor3", theme.Accent)
            end
        elseif obj:IsA("Frame") and obj.Name == "ToggleItem" then
            -- no-op: keep transparent containers untouched
        end
    end

    -- Rebuild visual styling for cards/buttons using the selected theme.
    -- Theme changes are visual-only: feature state is never modified.
    -- Repaint every existing switch from the current Toggle state.
    for featureKey, refs in pairs(ToggleSwitchRefs or {}) do
        local state = Toggles[featureKey] == true
        local btn, dot = refs.Button, refs.Dot
        if btn and btn.Parent then
            tweenColor(btn, "BackgroundColor3", state and theme.Accent or theme.CardStroke)
        end
        if dot and dot.Parent then
            tweenColor(dot, "BackgroundColor3", Color3.fromRGB(245,245,250))
        end
    end

    for _, obj in ipairs(canvasGroup:GetDescendants()) do
        if obj:IsA("Frame") and obj.Name == "MainFrame" then
            obj.BackgroundColor3 = theme.MainBg
        elseif obj:IsA("TextButton") and obj.Name == "OptionButton" then
            tweenColor(obj, "BackgroundColor3", theme.CardBg)
        elseif obj:IsA("TextButton") and obj.Name == "SwitchButton" then
            if obj.Parent and obj.Parent.Parent then
                local featureName = obj.Parent.Parent.Name
                local state = false
                for key, _ in pairs(Toggles) do
                    if key == featureName then state = Toggles[key] break end
                end
                tweenColor(obj, "BackgroundColor3", state and theme.Accent or theme.CardStroke)
            end
        end
    end

    notify(L("UITheme"), L("ThemeSet") .. themeName, 3)
    if Toggles.AutoSaveConfig then saveConfig() end
end

