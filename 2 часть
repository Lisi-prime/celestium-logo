local function rebuildCoinCache()
    local mapFolder = workspace:FindFirstChild("Map")
    if not mapFolder then
        cachedMapFolder = nil
        cachedCoinParts = {}
        return
    end
    cachedMapFolder = mapFolder
    local result = {}
    for _, item in ipairs(mapFolder:GetDescendants()) do
        if item.Name == "Coin" and item:IsA("BasePart") then
            result[#result + 1] = item
        elseif item.Name == "CoinContainer" then
            local part = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart")
            if part then result[#result + 1] = part end
        end
    end
    cachedCoinParts = result
    coinScanStamp = os.clock()
end

local function getCoinList()
    local map = workspace:FindFirstChild("Map")
    if cachedMapFolder ~= map or os.clock() - coinScanStamp > 2 then
        rebuildCoinCache()
    end
    local valid = {}
    for _, coin in ipairs(cachedCoinParts) do
        if coin and coin.Parent and coin:IsA("BasePart") then
            valid[#valid + 1] = coin
        end
    end
    cachedCoinParts = valid
    return valid
end

