local function roleDisplay(role)
    if role == "Murderer" then return "🔪 Murderer", Color3.fromRGB(255, 75, 75)
    elseif role == "Sheriff" then return "🔫 Sheriff", Color3.fromRGB(80, 160, 255)
    elseif role == "Hero" then return "⭐ Hero", Color3.fromRGB(255, 205, 70)
    elseif role == "Dead" then return "💀 Dead", Color3.fromRGB(130, 130, 145)
    else return "👤 Innocent", Color3.fromRGB(170, 175, 190) end
end

local function flingTarget(target)
    if not target or target == player then return end
    local char = target.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- Local physics impulse; the server may override it when it owns the target.
    pcall(function()
        local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        local dir = myRoot and (root.Position - myRoot.Position).Unit or Vector3.new(0,1,0)
        root.AssemblyLinearVelocity = dir * 180 + Vector3.new(0, 240, 0)
        root.AssemblyAngularVelocity = Vector3.new(90, 220, 90)
    end)
end

local function rebuildPlayerList()
    for _, child in ipairs(playerScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local roster = {}
    for _, p in ipairs(Players:GetPlayers()) do
        local role = getMM2Role(p)
        roster[#roster + 1] = {Player = p, Role = role, Order = roleOrder[role] or 3}
    end

    table.sort(roster, function(a, b)
        if a.Order ~= b.Order then return a.Order < b.Order end
        return a.Player.Name:lower() < b.Player.Name:lower()
    end)

    for index, entry in ipairs(roster) do
        local target = entry.Player
        local roleText, roleColor = roleDisplay(entry.Role)

        local item = Instance.new("TextButton")
        item.Name = "Player_" .. target.UserId
        item.LayoutOrder = index
        item.Size = UDim2.new(1, -4, 0, 42)
